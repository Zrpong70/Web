<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>LINKBOARD</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Syne+Mono&family=Sarabun:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f7f5f0;
  --surface: #ffffff;
  --surface2: #f0ede6;
  --border: #e4e0d8;
  --text: #1c1a16;
  --sub: #9a9488;
  --accent: #ff4d00;
  --accent2: #ffb800;
  --accent3: #0057ff;
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.06), 0 0 0 1px rgba(0,0,0,0.04);
  --shadow-md: 0 8px 24px rgba(0,0,0,0.10), 0 0 0 1px rgba(0,0,0,0.04);
  --shadow-lg: 0 20px 48px rgba(0,0,0,0.14), 0 0 0 1px rgba(0,0,0,0.05);
  --radius: 18px;
  --radius-sm: 10px;
  --font: 'Syne', sans-serif;
  --mono: 'Syne Mono', monospace;
  --body: 'Sarabun', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--body);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  padding-bottom: 120px;
}

/* Noise texture overlay */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 9999;
  opacity: 0.4;
}

.app { max-width: 540px; margin: 0 auto; padding: 0 16px; }

/* Header */
.header {
  padding: 32px 0 24px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.header-left {}
.logo {
  font-family: var(--font);
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -1px;
  line-height: 1;
  color: var(--text);
}
.logo span { color: var(--accent); }
.header-sub {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--sub);
  margin-top: 4px;
  letter-spacing: 0.5px;
}
.btn-add-col {
  background: var(--accent);
  color: white;
  border: none;
  border-radius: 50px;
  padding: 10px 18px;
  font-family: var(--font);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  box-shadow: 0 4px 12px rgba(255,77,0,0.3);
  transition: all 0.2s;
  flex-shrink: 0;
}
.btn-add-col:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(255,77,0,0.35); }
.btn-add-col:active { transform: scale(0.97); }

/* Search */
.search-wrap { position: relative; margin-bottom: 24px; }
.search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--sub);
  font-size: 16px;
  pointer-events: none;
}
#searchInput {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 50px;
  padding: 13px 16px 13px 44px;
  font-family: var(--body);
  font-size: 14px;
  color: var(--text);
  outline: none;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}
#searchInput:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(255,77,0,0.1), var(--shadow-sm);
}
#searchInput::placeholder { color: var(--sub); }
.search-count {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  font-family: var(--mono);
  font-size: 11px;
  color: var(--sub);
}

/* Collections */
.collections { display: flex; flex-direction: column; gap: 24px; }

.collection {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border);
  overflow: hidden;
  animation: fadeUp 0.3s ease both;
}
@keyframes fadeUp { from { opacity:0; transform: translateY(12px); } to { opacity:1; transform: none; } }

.col-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px 16px 0;
}
.col-dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}
.col-name {
  font-family: var(--font);
  font-size: 15px;
  font-weight: 700;
  flex: 1;
  letter-spacing: -0.3px;
  cursor: pointer;
  outline: none;
  background: none;
  border: none;
  color: var(--text);
  padding: 2px 4px;
  border-radius: 4px;
  transition: background 0.15s;
}
.col-name:focus { background: var(--surface2); }
.col-count {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--sub);
  background: var(--surface2);
  padding: 2px 8px;
  border-radius: 20px;
}
.col-actions { display: flex; gap: 4px; }
.btn-sm {
  background: none;
  border: none;
  width: 28px; height: 28px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  color: var(--sub);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s;
}
.btn-sm:hover { background: var(--surface2); color: var(--text); }
.btn-sm.danger:hover { background: #fff0ee; color: var(--accent); }

/* Link grid */
.link-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  padding: 12px 16px 16px;
}

.link-card {
  background: var(--surface2);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  padding: 14px 10px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s;
  position: relative;
  min-height: 90px;
  animation: popIn 0.2s ease both;
  -webkit-tap-highlight-color: transparent;
}
@keyframes popIn { from { opacity:0; transform: scale(0.9); } to { opacity:1; transform: scale(1); } }
.link-card:hover {
  background: var(--surface);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
  border-color: transparent;
}
.link-card:active { transform: scale(0.97); }

.link-favicon {
  width: 36px; height: 36px;
  border-radius: 10px;
  object-fit: cover;
  background: var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px;
  overflow: hidden;
  flex-shrink: 0;
}
.link-favicon img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
.link-title {
  font-family: var(--font);
  font-size: 11px;
  font-weight: 600;
  text-align: center;
  color: var(--text);
  line-height: 1.3;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.link-domain {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--sub);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* Link card delete btn */
.link-del {
  position: absolute;
  top: 4px; right: 4px;
  width: 20px; height: 20px;
  border-radius: 50%;
  background: rgba(0,0,0,0.06);
  border: none;
  cursor: pointer;
  font-size: 11px;
  color: var(--sub);
  display: none;
  align-items: center;
  justify-content: center;
  line-height: 1;
  transition: all 0.15s;
}
.link-card:hover .link-del { display: flex; }
.link-del:hover { background: var(--accent); color: white; }

/* Add link btn */
.btn-add-link {
  background: none;
  border: 1.5px dashed var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 10px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
  color: var(--sub);
  font-size: 11px;
  font-family: var(--font);
  font-weight: 600;
  min-height: 90px;
  transition: all 0.2s;
}
.btn-add-link:hover { border-color: var(--accent); color: var(--accent); background: rgba(255,77,0,0.03); }
.btn-add-link .plus { font-size: 20px; line-height: 1; }

/* Empty state */
.empty-col {
  padding: 0 16px 20px;
  text-align: center;
  font-size: 13px;
  color: var(--sub);
  font-family: var(--body);
}

/* Empty overall */
.empty-all {
  text-align: center;
  padding: 60px 20px;
}
.empty-all .big { font-size: 48px; margin-bottom: 12px; }
.empty-all p { font-family: var(--font); font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 6px; }
.empty-all span { font-size: 13px; color: var(--sub); }

/* Modal */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 500;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
  backdrop-filter: blur(4px);
}
.overlay.show { opacity: 1; pointer-events: all; }

.sheet {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--surface);
  border-radius: 24px 24px 0 0;
  padding: 20px 20px 48px;
  z-index: 600;
  max-width: 540px;
  margin: 0 auto;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8px 40px rgba(0,0,0,0.12);
}
.overlay.show .sheet { transform: translateY(0); }

.sheet-handle {
  width: 36px; height: 4px;
  background: var(--border);
  border-radius: 2px;
  margin: 0 auto 20px;
}
.sheet-title {
  font-family: var(--font);
  font-size: 18px;
  font-weight: 800;
  margin-bottom: 20px;
  letter-spacing: -0.5px;
}

.field { margin-bottom: 14px; }
.field label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  color: var(--sub);
  margin-bottom: 6px;
  font-family: var(--mono);
  letter-spacing: 1px;
}
.field input {
  width: 100%;
  border: 1.5px solid var(--border);
  border-radius: 12px;
  padding: 12px 14px;
  font-size: 14px;
  font-family: var(--body);
  color: var(--text);
  background: var(--bg);
  outline: none;
  transition: border-color 0.15s;
}
.field input:focus { border-color: var(--accent); }
.field input::placeholder { color: var(--sub); }

/* URL preview */
.url-preview {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--surface2);
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 14px;
  min-height: 48px;
}
.preview-favicon {
  width: 32px; height: 32px;
  border-radius: 8px;
  background: var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
  flex-shrink: 0;
  overflow: hidden;
}
.preview-favicon img { width: 100%; height: 100%; object-fit: cover; }
.preview-info { flex: 1; min-width: 0; }
.preview-title { font-size: 13px; font-weight: 600; color: var(--text); font-family: var(--font); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.preview-domain { font-size: 11px; color: var(--sub); font-family: var(--mono); }

.color-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.color-dot {
  width: 28px; height: 28px;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid transparent;
  transition: transform 0.15s;
}
.color-dot:hover { transform: scale(1.15); }
.color-dot.selected { border-color: var(--text); }

.sheet-actions { display: grid; grid-template-columns: 1fr 2fr; gap: 10px; }
.btn-cancel2 {
  padding: 14px;
  background: var(--surface2);
  border: none;
  border-radius: 12px;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 600;
  color: var(--sub);
  cursor: pointer;
  transition: all 0.15s;
}
.btn-confirm {
  padding: 14px;
  background: var(--accent);
  border: none;
  border-radius: 12px;
  font-family: var(--font);
  font-size: 14px;
  font-weight: 700;
  color: white;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(255,77,0,0.3);
  transition: all 0.15s;
  letter-spacing: 0.3px;
}
.btn-confirm:active { transform: scale(0.98); }

/* Toast */
.toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: var(--text);
  color: white;
  font-family: var(--font);
  font-size: 13px;
  font-weight: 600;
  padding: 12px 22px;
  border-radius: 50px;
  z-index: 9000;
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  white-space: nowrap;
  box-shadow: var(--shadow-lg);
}
.toast.show { transform: translateX(-50%) translateY(0); }

/* Loading spinner */
.spinner {
  width: 16px; height: 16px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  display: inline-block;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Drag styles */
.link-card.dragging { opacity: 0.4; }
.link-card.drag-over { border-color: var(--accent); background: rgba(255,77,0,0.05); }

/* Search highlight */
.collection.hidden { display: none; }
.link-card.hidden { display: none; }

mark {
  background: rgba(255,184,0,0.3);
  color: inherit;
  border-radius: 2px;
  padding: 0 1px;
}
</style>
</head>
<body>
<div class="app">

  <div class="header">
    <div class="header-left">
      <div class="logo">LINK<span>BOARD</span></div>
      <div class="header-sub" id="headerSub">loading...</div>
    </div>
    <button class="btn-add-col" onclick="openNewCollection()">+ Collection</button>
  </div>

  <div class="search-wrap">
    <span class="search-icon">🔍</span>
    <input type="text" id="searchInput" placeholder="ค้นหาลิงก์หรือ collection..." oninput="doSearch(this.value)">
    <span class="search-count" id="searchCount"></span>
  </div>

  <div class="collections" id="collectionsEl"></div>

</div>

<!-- Overlay + Sheet (reused) -->
<div class="overlay" id="overlay" onclick="closeSheet()">
  <div class="sheet" onclick="event.stopPropagation()" id="sheet">
    <div class="sheet-handle"></div>
    <div id="sheetContent"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const KEY = 'linkboard_v1';
const COLORS = ['#ff4d00','#ffb800','#0057ff','#00b894','#a855f7','#ec4899','#1c1a16','#64748b'];

let data = JSON.parse(localStorage.getItem(KEY) || 'null') || { collections: [] };
let dragSrc = null;

function save() { localStorage.setItem(KEY, JSON.stringify(data)); }

function getDomain(url) {
  try { return new URL(url).hostname.replace('www.',''); } catch { return url; }
}

function getFaviconUrl(url) {
  try {
    const domain = new URL(url).origin;
    return `https://www.google.com/s2/favicons?domain=${domain}&sz=64`;
  } catch { return null; }
}

function genId() { return Date.now() + Math.random().toString(36).slice(2,6); }

// ─── RENDER ───────────────────────────────────────
function render() {
  const el = document.getElementById('collectionsEl');
  const total = data.collections.reduce((s,c)=>s+c.links.length,0);
  document.getElementById('headerSub').textContent =
    `${data.collections.length} collections · ${total} links`;

  if (!data.collections.length) {
    el.innerHTML = `<div class="empty-all">
      <div class="big">🔗</div>
      <p>ยังไม่มี Collection</p>
      <span>กด "+ Collection" เพื่อเริ่มต้นได้เลย</span>
    </div>`;
    return;
  }

  el.innerHTML = '';
  data.collections.forEach((col, ci) => {
    const colEl = document.createElement('div');
    colEl.className = 'collection';
    colEl.dataset.ci = ci;

    const gridLinks = col.links.map((lk, li) => linkCardHTML(lk, ci, li)).join('');

    colEl.innerHTML = `
      <div class="col-header">
        <div class="col-dot" style="background:${col.color}"></div>
        <div class="col-name" contenteditable="true" spellcheck="false"
          onblur="renameCol(${ci}, this.textContent.trim())"
          onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur()}"
        >${col.name}</div>
        <span class="col-count">${col.links.length}</span>
        <div class="col-actions">
          <button class="btn-sm danger" onclick="deleteCollection(${ci})" title="ลบ collection">🗑</button>
        </div>
      </div>
      <div class="link-grid" id="grid-${ci}" ondragover="onDragOver(event,${ci})" ondrop="onDrop(event,${ci})">
        ${gridLinks}
        <button class="btn-add-link" onclick="openAddLink(${ci})">
          <span class="plus">+</span>
          <span>เพิ่มลิงก์</span>
        </button>
      </div>
    `;
    el.appendChild(colEl);
  });
}

function linkCardHTML(lk, ci, li) {
  const favicon = getFaviconUrl(lk.url);
  const faviconEl = favicon
    ? `<div class="link-favicon"><img src="${favicon}" onerror="this.parentElement.textContent='🌐'"></div>`
    : `<div class="link-favicon">🌐</div>`;
  return `
    <a class="link-card" href="${lk.url}" target="_blank" rel="noopener"
      draggable="true"
      ondragstart="onDragStart(event,${ci},${li})"
      ondragend="onDragEnd(event)"
      data-ci="${ci}" data-li="${li}"
      data-title="${(lk.title||'').toLowerCase()}"
      data-domain="${getDomain(lk.url).toLowerCase()}"
    >
      <button class="link-del" onclick="event.preventDefault();event.stopPropagation();deleteLink(${ci},${li})" title="ลบ">✕</button>
      ${faviconEl}
      <span class="link-title">${lk.title || getDomain(lk.url)}</span>
      <span class="link-domain">${getDomain(lk.url)}</span>
    </a>
  `;
}

// ─── SEARCH ───────────────────────────────────────
function doSearch(q) {
  q = q.toLowerCase().trim();
  const countEl = document.getElementById('searchCount');
  if (!q) {
    document.querySelectorAll('.collection').forEach(c => c.classList.remove('hidden'));
    document.querySelectorAll('.link-card').forEach(c => c.classList.remove('hidden'));
    countEl.textContent = '';
    return;
  }
  let found = 0;
  document.querySelectorAll('.collection').forEach(colEl => {
    let colVisible = false;
    colEl.querySelectorAll('.link-card').forEach(card => {
      const title = card.dataset.title || '';
      const domain = card.dataset.domain || '';
      const match = title.includes(q) || domain.includes(q);
      card.classList.toggle('hidden', !match);
      if (match) { colVisible = true; found++; }
    });
    colEl.classList.toggle('hidden', !colVisible);
  });
  countEl.textContent = found ? `${found}` : '0';
}

// ─── DRAG & DROP ──────────────────────────────────
function onDragStart(e, ci, li) {
  dragSrc = { ci, li };
  e.currentTarget.classList.add('dragging');
  e.dataTransfer.effectAllowed = 'move';
}
function onDragEnd(e) { e.currentTarget.classList.remove('dragging'); }
function onDragOver(e, ci) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; }
function onDrop(e, toCi) {
  e.preventDefault();
  if (!dragSrc) return;
  const { ci: fromCi, li: fromLi } = dragSrc;
  const toEl = e.target.closest('.link-card');
  const toLi = toEl ? parseInt(toEl.dataset.li) : data.collections[toCi].links.length;
  const [item] = data.collections[fromCi].links.splice(fromLi, 1);
  data.collections[toCi].links.splice(toLi, 0, item);
  dragSrc = null;
  save(); render();
}

// ─── SHEET ────────────────────────────────────────
function openSheet() { document.getElementById('overlay').classList.add('show'); }
function closeSheet() { document.getElementById('overlay').classList.remove('show'); }

function openNewCollection() {
  let selectedColor = COLORS[Math.floor(Math.random()*COLORS.length)];
  const dots = COLORS.map(c =>
    `<div class="color-dot ${c===selectedColor?'selected':''}" style="background:${c}" onclick="selectColor('${c}',this)"></div>`
  ).join('');

  document.getElementById('sheetContent').innerHTML = `
    <div class="sheet-title">New Collection</div>
    <div class="field">
      <label>COLLECTION NAME</label>
      <input type="text" id="colName" placeholder="เช่น Work, Entertainment, Study..." autofocus>
    </div>
    <div class="field"><label>COLOR</label></div>
    <div class="color-row" id="colorRow">${dots}</div>
    <div class="sheet-actions">
      <button class="btn-cancel2" onclick="closeSheet()">ยกเลิก</button>
      <button class="btn-confirm" onclick="confirmNewCollection()">สร้าง Collection</button>
    </div>
  `;
  window._selectedColor = selectedColor;
  openSheet();
  setTimeout(() => document.getElementById('colName')?.focus(), 100);
}

function selectColor(c, el) {
  window._selectedColor = c;
  document.querySelectorAll('.color-dot').forEach(d => d.classList.remove('selected'));
  el.classList.add('selected');
}

function confirmNewCollection() {
  const name = document.getElementById('colName').value.trim();
  if (!name) { showToast('ใส่ชื่อ collection ก่อนนะ 😅'); return; }
  data.collections.push({ id: genId(), name, color: window._selectedColor || COLORS[0], links: [] });
  save(); render(); closeSheet();
  showToast('✓ สร้าง collection แล้ว!');
}

function openAddLink(ci) {
  document.getElementById('sheetContent').innerHTML = `
    <div class="sheet-title">เพิ่มลิงก์</div>
    <div class="field">
      <label>URL</label>
      <input type="url" id="linkUrl" placeholder="https://..." oninput="previewUrl(this.value)">
    </div>
    <div class="url-preview" id="urlPreview" style="display:none"></div>
    <div class="field">
      <label>ชื่อ (ไม่บังคับ)</label>
      <input type="text" id="linkTitle" placeholder="ระบบจะดึงชื่ออัตโนมัติ">
    </div>
    <div class="sheet-actions">
      <button class="btn-cancel2" onclick="closeSheet()">ยกเลิก</button>
      <button class="btn-confirm" onclick="confirmAddLink(${ci})">เพิ่มลิงก์</button>
    </div>
  `;
  openSheet();
  setTimeout(() => document.getElementById('linkUrl')?.focus(), 100);
}

let previewTimer;
function previewUrl(val) {
  clearTimeout(previewTimer);
  const preview = document.getElementById('urlPreview');
  if (!val || !val.startsWith('http')) { preview.style.display = 'none'; return; }
  preview.style.display = 'flex';
  preview.innerHTML = `<div class="spinner"></div><div style="font-size:12px;color:var(--sub);margin-left:8px">กำลังดึงข้อมูล...</div>`;

  previewTimer = setTimeout(() => {
    let url = val;
    try { url = new URL(val).href; } catch {}
    const domain = getDomain(url);
    const favicon = getFaviconUrl(url);
    const title = document.getElementById('linkTitle').value || domain;

    preview.innerHTML = `
      <div class="preview-favicon">
        ${favicon ? `<img src="${favicon}" onerror="this.parentElement.textContent='🌐'">` : '🌐'}
      </div>
      <div class="preview-info">
        <div class="preview-title">${title}</div>
        <div class="preview-domain">${domain}</div>
      </div>
    `;

    // Try auto-fill title if empty
    if (!document.getElementById('linkTitle').value) {
      document.getElementById('linkTitle').placeholder = domain;
    }
  }, 600);
}

function confirmAddLink(ci) {
  let url = (document.getElementById('linkUrl').value || '').trim();
  if (!url) { showToast('ใส่ URL ก่อนนะ'); return; }
  if (!url.startsWith('http')) url = 'https://' + url;
  try { new URL(url); } catch { showToast('URL ไม่ถูกต้อง'); return; }

  const title = document.getElementById('linkTitle').value.trim() || getDomain(url);
  data.collections[ci].links.push({ id: genId(), url, title });
  save(); render(); closeSheet();
  showToast('✓ เพิ่มลิงก์แล้ว!');
}

function renameCol(ci, name) {
  if (!name) return;
  data.collections[ci].name = name;
  save();
  // update count badge only
  const countEl = document.querySelector(`[data-ci="${ci}"] .col-count`);
}

function deleteCollection(ci) {
  if (!confirm(`ลบ "${data.collections[ci].name}" และลิงก์ทั้งหมด?`)) return;
  data.collections.splice(ci, 1);
  save(); render();
  showToast('✓ ลบ collection แล้ว');
}

function deleteLink(ci, li) {
  data.collections[ci].links.splice(li, 1);
  save(); render();
  showToast('✓ ลบลิงก์แล้ว');
}

function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2200);
}

render();
</script>
</body>
</html>
